# Cloud 환경의 Secrets에 등록. 실제 키를 Git이나 채팅에 붙여 넣지 않는다.
GEMINI_API_KEY=
# 서버/CLI 전용. SUPABASE_URL은 https://<project-ref>.supabase.co 형식.
# 서비스 역할 키는 브라우저 코드나 채팅에 넣지 않는다.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# 실행 시 node --env-file=.env 지원 (로컬에서만 선택 사용)
# 관리자 전용 토큰. 미설정 시 로컬 비공개 파일에 임시 발급한다.
ADMIN_ACCESS_TOKEN=
# 실제 요금제의 기준 용량(바이트)을 확인한 후 선택 설정. 기본 추정값 없음.
ADMIN_DATABASE_CAPACITY_BYTES=
ADMIN_STORAGE_CAPACITY_BYTES=
# Gmail API 발송 전용 OAuth. 실제 값은 서버 Secrets에만 등록한다.
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
GMAIL_SENDER=peter@humansyntax.kr
